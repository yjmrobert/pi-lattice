{
  "name": "@pi-lattice/roles",
  "version": "0.1.0",
  "description": "Composable roles for Pi sessions: markdown fragments a human assigns, combines and changes mid-session.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "roles",
    "multi-agent"
  ],
  "files": [
    "src",
    "fragments",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "dependencies": {
    "@pi-lattice/protocol": "0.1.0"
  },
  "bundledDependencies": [
    "@pi-lattice/protocol"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
