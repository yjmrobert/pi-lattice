{
  "name": "pi-lattice",
  "version": "0.1.0",
  "private": true,
  "description": "pi-lattice, assembled: the Pi package that bundles the lattice extensions, and the background host they talk to.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "multi-agent",
    "session-tree",
    "a2a"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "bin": {
    "pi-lattice": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/launcher.ts",
      "./node_modules/@pi-lattice/pane/src/extension.ts",
      "./node_modules/@pi-lattice/canopy/src/extension.ts",
      "./node_modules/@pi-lattice/a2a/src/extension.ts",
      "./node_modules/@pi-lattice/roles/src/extension.ts",
      "./node_modules/@pi-lattice/graph/src/extension.ts"
    ]
  },
  "dependencies": {
    "@pi-lattice/a2a": "0.1.0",
    "@pi-lattice/canopy": "0.1.0",
    "@pi-lattice/collab": "0.1.0",
    "@pi-lattice/graph": "0.1.0",
    "@pi-lattice/host": "0.1.0",
    "@pi-lattice/pane": "0.1.0",
    "@pi-lattice/protocol": "0.1.0",
    "@pi-lattice/roles": "0.1.0",
    "@pi-lattice/server": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
