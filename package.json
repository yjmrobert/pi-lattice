{
  "name": "pi-lattice",
  "private": true,
  "version": "0.0.0",
  "description": "Agent-to-agent messaging, session trees, composable roles and shared ownership for Pi",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run --passWithNoTests",
    "spike:phase0": "node spikes/phase0/run.mjs",
    "spike:canopy": "vitest --run --dir spikes/canopy --config spikes/canopy/vitest.config.ts",
    "check": "npm run typecheck && npm test",
    "lattice": "node packages/app/src/cli.ts",
    "dev": "node scripts/dev.mjs",
    "docs": "node scripts/settings-doc.ts",
    "eval": "node scripts/eval.ts",
    "build": "node scripts/pack.mjs",
    "release": "npm run check && npm run build && npm publish ./dist/pi-lattice --access public"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^24.0.0",
    "@xterm/headless": "6.0.0",
    "rolldown": "1.2.18",
    "typebox": "1.3.27",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "multi-agent",
    "session-tree",
    "a2a"
  ],
  "pi": {
    "extensions": [
      "./packages/app/src/launcher.ts",
      "./packages/pane/src/extension.ts",
      "./packages/canopy/src/extension.ts",
      "./packages/a2a/src/extension.ts",
      "./packages/roles/src/extension.ts",
      "./packages/graph/src/extension.ts"
    ]
  }
}
